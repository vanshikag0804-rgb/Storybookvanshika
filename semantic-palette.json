{
  "$description": "Semantic color tokens aliased to base-palette.json primitives. Default configuration: blue primary/CTA 600, slate neutral.",
  "semantic": {
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{slate.900}"
      },
      "secondary": {
        "$type": "color",
        "$value": "{slate.700}"
      },
      "muted": {
        "$type": "color",
        "$value": "{slate.500}"
      },
      "inverse": {
        "$type": "color",
        "$value": "{base.white}"
      },
      "link": {
        "$type": "color",
        "$value": "{blue.600}"
      }
    },
    "surface": {
      "primary": {
        "$type": "color",
        "$value": "{base.white}"
      },
      "secondary": {
        "$type": "color",
        "$value": "{slate.50}"
      },
      "tertiary": {
        "$type": "color",
        "$value": "{slate.100}"
      },
      "inverse": {
        "$type": "color",
        "$value": "{slate.900}"
      },
      "elevated": {
        "$type": "color",
        "$value": "{base.white}"
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "{slate.200}"
      },
      "strong": {
        "$type": "color",
        "$value": "{slate.400}"
      },
      "focus": {
        "$type": "color",
        "$value": "{blue.600}"
      }
    },
    "interactive": {
      "default": {
        "$type": "color",
        "$value": "{blue.600}"
      },
      "hover": {
        "$type": "color",
        "$value": "{blue.700}"
      },
      "pressed": {
        "$type": "color",
        "$value": "{blue.800}"
      },
      "disabled": {
        "$type": "color",
        "$value": "{slate.300}"
      }
    },
    "feedback": {
      "success": {
        "bg": {
          "$type": "color",
          "$value": "{green.50}"
        },
        "text": {
          "$type": "color",
          "$value": "{green.800}"
        },
        "border": {
          "$type": "color",
          "$value": "{green.200}"
        }
      },
      "warning": {
        "bg": {
          "$type": "color",
          "$value": "{amber.50}"
        },
        "text": {
          "$type": "color",
          "$value": "{amber.800}"
        },
        "border": {
          "$type": "color",
          "$value": "{amber.200}"
        }
      },
      "error": {
        "bg": {
          "$type": "color",
          "$value": "{red.50}"
        },
        "text": {
          "$type": "color",
          "$value": "{red.800}"
        },
        "border": {
          "$type": "color",
          "$value": "{red.200}"
        }
      },
      "info": {
        "bg": {
          "$type": "color",
          "$value": "{sky.50}"
        },
        "text": {
          "$type": "color",
          "$value": "{sky.800}"
        },
        "border": {
          "$type": "color",
          "$value": "{sky.200}"
        }
      }
    }
  }
}